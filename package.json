{
  "name": "guitarshell",
  "version": "0.1.21-b",
  "private": true,
  "description": "Guitar Shell Android shell",
  "scripts": {
    "check": "node scripts/check.mjs",
    "www": "node scripts/build-www.mjs",
    "cap:add": "npm run www && cap add android",
    "cap:sync": "npm run www && cap sync android",
    "apk:debug": "node scripts/build-apk.mjs debug",
    "apk:release": "node scripts/build-apk.mjs"
  },
  "dependencies": {
    "@capacitor/android": "6.2.3",
    "@capacitor/core": "6.2.3"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.3"
  }
}
